# Copy to .env and fill in. Never commit .env.
# Keys: Alpaca dashboard -> (Paper or Live) -> API Keys. Paper and live keys differ.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Strategy
SYMBOL=TQQQ             # SPYM for an unleveraged S&P 500 version
TREND_SMA_DAYS=200      # blank = trade every night
SKIP_WEEKENDS=false

# Down-day bounce rule (NY Fed "overnight drift"; see research/overnight_drift.py).
# DOWN_DAY=daily + DOWN_DAY_OVERRIDES_TREND=true: also hold on nights the price fell today,
# even when it's below the 200-day average. Blank DOWN_DAY = off (trend rule only).
DOWN_DAY=daily
DOWN_DAY_MIN_PCT=0
DOWN_DAY_OVERRIDES_TREND=true

# Risk
MAX_POSITION_USD=500    # never put more than this into a position
ENTRY_LIMIT_PCT=0.02    # skip the night if the price runs >2% above the last trade before the buy fills
MAX_DRAWDOWN_PCT=0.50   # halt new entries if equity drops this far below its peak (3x funds swing hard)

# "regular": normal buy ~15 min before the close + market sell queued for the next open (works in paper).
# "auction": closing-auction buy + opening-auction sell (slightly better fills; Alpaca paper never fills these).
EXECUTION=regular

# Optional: email every buy/sell/error through this SNS topic (needs AWS credentials or an EC2 IAM role).
ALERT_TOPIC_ARN=
